# OmniChat API Keys
# Copy this file to .env.local and add your actual API keys

# Google Gemini (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional - falls back to Gemini simulation if not provided)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional - falls back to Gemini simulation if not provided)
CLAUDE_API_KEY=your_claude_api_key_here

# Alibaba Qwen (Optional - falls back to Gemini simulation if not provided)
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek (Optional - falls back to Gemini simulation if not provided)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
